---
extends: default

rules:
  braces: enable
  brackets: enable
  colons: enable
  commas: enable
  document-start: disable
  empty-lines: enable
  indentation: enable
  line-length: disable
  new-line-at-end-of-file: enable
  new-lines: enable
  trailing-spaces: enable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
