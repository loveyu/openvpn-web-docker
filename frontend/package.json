{
  "name": "openvpn-web-ui",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "check": "oxlint -D correctness -D suspicious --deny-warnings . && tsc --noEmit",
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write 'src/**/*.{css,html,js,json,ts,tsx}' 'index.html' 'public/**/*.js' package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check 'src/**/*.{css,html,js,json,ts,tsx}' 'index.html' 'public/**/*.js' package.json tsconfig.json vite.config.ts",
    "lint": "oxlint -D correctness -D suspicious --deny-warnings .",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "react-syntax-highlighter": "16.1.2",
    "refractor": "5.0.0",
    "strip-ansi": "7.1.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.93.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
