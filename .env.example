# 启动前设置管理后台 Basic Auth 用户名和强密码，两项必须同时提供。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TZ=Asia/Shanghai
# 仅本机访问；可信局域网使用可改为宿主机局域网 IP。
BIND_ADDRESS=127.0.0.1
# 以下仅控制宿主机映射，容器端口固定为 80、8888、1080、22。
WEB_PORT=18080
HTTP_PROXY_PORT=17888
SOCKS5_PORT=17080
SSH_PORT=17222
# 仅开发模式启用 Supervisor HTTP 管理，固定绑定宿主机 127.0.0.1。
SUPERVISOR_PORT=19001
# 可设置为 ghcr.io/loveyu/openvpn-web-docker:latest。
IMAGE=openvpn-web:local
