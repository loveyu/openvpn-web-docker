# 管理后台 Basic Auth，默认不启用；启用时必须同时设置这两项。
ADMIN_USERNAME=
ADMIN_PASSWORD=
TZ=Asia/Shanghai
# 仅本机访问；可信局域网使用可改为宿主机局域网 IP。
BIND_ADDRESS=127.0.0.1
# 以下仅控制宿主机映射，容器端口固定为 80、8888、1080、22。
WEB_PORT=18080
HTTP_PROXY_PORT=17888
SOCKS5_PORT=17080
SSH_PORT=17222
# 可设置为 ghcr.io/loveyu/openvpn-web-docker:latest。
IMAGE=openvpn-web:local
